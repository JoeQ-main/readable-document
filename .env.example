# Copy this file to .env (same folder) and paste your Claude API key.
# .env is ignored by git; never commit a real key.
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Optional: the model used for reading. Default is claude-opus-5-5.
# claude-sonnet-5-5 is about half the price per token.
# READABLE_MODEL=claude-sonnet-5-5
